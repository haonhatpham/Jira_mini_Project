# Connection string PostgreSQL dung cho backend.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/training_program

# So connection toi da trong PostgreSQL pool.
DATABASE_POOL_MAX=10

# Dong connection nhan roi sau thoi gian khong hoat dong.
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Timeout khi khong mo duoc connection den database.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# Port Express server lang nghe.
PORT=3001

# Secret ky/verify JWT; hay thay bang chuoi dai ngau nhien khi chay that.
JWT_SECRET=change_this_to_a_long_random_secret

# Thoi gian het han JWT.
JWT_EXPIRES_IN=1h

# So bcrypt salt rounds, toi thieu 10.
PASSWORD_SALT_ROUNDS=10
